# Notion -- create an internal integration at https://www.notion.so/my-integrations,
# then open the "Job Tracker 2026" database, click "..." -> Connections, and
# add that integration so it can read/write the database.
NOTION_TOKEN=secret_xxx

# The database id from the Job Tracker 2026 URL:
# https://www.notion.so/<workspace>/<DATABASE_ID>?v=...
NOTION_DATABASE_ID=your-database-id-here

# Anthropic -- https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-sonnet-4-5

# Phase 4 (tailoring) -- folder containing your three base CVs
# (Hamideh_Ahooei_CV_AI_Transformation_Consultant.docx, etc). Leave unset to
# skip tailoring; jobs will stay scored-but-not-tailored in Notion.
CV_FOLDER_PATH=/path/to/your/CV/folder
# Where tailored .docx/.pdf files get written. Defaults to data/tailored/
# inside this project if unset -- point it at your actual CV folder (or a
# "Claude outputs" subfolder in it) to have them land where you keep everything.
CV_OUTPUT_DIR=/path/to/your/CV/folder/Claude outputs

# Phase 5 (auto-apply) -- fills (and, if you turn on AUTO_SUBMIT_CONFIRMED,
# submits) applications for Greenhouse/Ashby/Lever jobs you've set to
# "Approved" in Notion. See the safety notes at the top of pipeline/apply.py
# before turning this on. LinkedIn/Indeed jobs are never auto-applied to.
APPLICANT_FIRST_NAME=Hamideh
APPLICANT_LAST_NAME=Ahooei
APPLICANT_EMAIL=you@example.com
APPLICANT_PHONE=+1-555-555-5555

# Leave false (default) to only fill the form and take a screenshot for you
# to review -- nothing is ever submitted. Set to true only once you've
# reviewed several dry-run screenshots and trust the fill quality.
AUTO_SUBMIT_CONFIRMED=false

# Set to false to watch the browser fill forms live (useful the first few
# times you run this). Defaults to true (headless) otherwise.
APPLY_HEADLESS=true

# Where filled-application screenshots get written. Defaults to
# data/screenshots/ inside this project if unset.
APPLY_SCREENSHOT_DIR=/path/to/your/CV/folder/Claude outputs/screenshots
