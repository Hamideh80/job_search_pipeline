# Notion -- create an internal integration at https://www.notion.so/my-integrations,
# then open the "Job Tracker 2026" database, click "..." -> Connections, and
# add that integration so it can read/write the database.
NOTION_TOKEN=secret_xxx

# The database id from the Job Tracker 2026 URL:
# https://www.notion.so/<workspace>/<DATABASE_ID>?v=...
NOTION_DATABASE_ID=b5e93a2e1c7246029db86f70393f3eda

# Anthropic -- https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-sonnet-4-5
